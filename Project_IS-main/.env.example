# Server Configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Security & Session
# Generate a strong random secret for production (e.g. openssl rand -hex 32)
SESSION_SECRET=dev-only-change-this-secret-key-before-production
SESSION_MAX_AGE_MS=28800000
COOKIE_SECURE=false

# Database & Storage
DB_PATH=./database/attendsecure.db
EVIDENCE_DIR=./storage/evidence

# Upload Limits
MAX_UPLOAD_BYTES=2097152

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Demo Seed (development only - never enable in production)
DEMO_SEED_PASSWORD=AttendSecure@2026
